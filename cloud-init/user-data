#cloud-config

# ---- System identity ----

# ---- Users and access ----
users:
  - name: svc-ansible
    gecos: Ansible Automation User
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users, sudo
    # A locked account (`!` in /etc/shadow) fails PAM's account phase, which
    # blocks sshd pubkey auth too, not just password auth.
    #
    # `lock_passwd: false` on its own does NOT prevent this. cloud-init runs
    # `useradd` without `-p`, so the account is created with `!` already set,
    # and distros/__init__.py only calls unlock_passwd() when a password was
    # *also* supplied — otherwise it just skips the explicit lock and logs
    # "Not unlocking password for user ... but no 'passwd'/'plain_text_passwd'
    # /'hashed_passwd' provided in user-data". The account stays locked.
    #
    # `hashed_passwd: "*"` satisfies that condition without granting a password
    # login: `*` is the conventional "no valid password hash" value, and
    # cloud-init's unlock_passwd (`passwd -u`) leaves `*` intact rather than
    # blanking it. Net result: key-only auth, account not locked.
    lock_passwd: false
    hashed_passwd: "*"
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINNNxBpnr25dNfo6AYBcq59yfVJ+dB8tjOK8VhQi7SSL

# Disable risky defaults
disable_root: true
ssh_pwauth: false

# ---- Package behavior ----
package_update: true
package_upgrade: false

packages:
  - curl
  - vim
  - ca-certificates
  - openssh-server

# ---- Optional but useful ----
# Canonical IANA zone name. Debian 13 ships only the primary zoneinfo tree;
# legacy aliases like `US/Mountain` live in the separate `tzdata-legacy`
# package and resolve to nothing without it, failing cc_timezone with
# "Invalid timezone US/Mountain, no file found at /usr/share/zoneinfo/...".
# Keep this in sync with `system_timezone` in the Ansible inventory, which
# is authoritative (the baseline role re-applies it).
timezone: America/Denver

# ---- Final signal ----
final_message: |
  cloud-init has finished.
  System identity and SSH access are configured.
  Ready for Ansible.
